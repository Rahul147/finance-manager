<% merchant = @transaction.merchant.presence || "Unknown merchant" %>
<% category = @transaction.category.presence || "Uncategorized" %>
<% transaction_date = @transaction.transaction_date || @transaction.created_at.to_date %>
<% relative_time = time_ago_in_words(@transaction.created_at) %>
<% currency = @transaction.currency.presence || "INR" %>
<% amount_display = transaction_amount_display(@transaction) %>
<% email = @transaction.email %>
<% status_label = @transaction.status.presence || "Unlabeled" %>
<% status_styles = transaction_status_styles(@transaction.status) %>
<% type_label = @transaction.transaction_type_label || "Unclassified" %>

<div class="min-h-screen bg-slate-50">
  <%# Header %>
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-4">
      <div class="flex items-center gap-4">
        <%= link_to transactions_path,
            class: "inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-200",
            data: { turbo_frame: "_top" } do %>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
          </svg>
          Back
        <% end %>
        <span class="text-sm text-slate-500">Transaction #<%= @transaction.id %></span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-6 py-6">
    <%# Main Card %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex items-start gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-xl bg-slate-100 text-lg font-bold text-slate-600">
              <%= merchant.first(2).upcase %>
            </div>
            <div>
              <h1 class="text-2xl font-bold text-slate-900"><%= merchant %></h1>
              <div class="mt-1 flex items-center gap-2 text-sm text-slate-500">
                <span><%= category %></span>
                <span class="text-slate-300">&bull;</span>
                <span><%= type_label %></span>
              </div>
            </div>
          </div>
          <div class="text-right">
            <p class="text-3xl font-bold text-slate-900"><%= amount_display %></p>
            <span class="mt-2 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium <%= status_label.downcase == 'posted' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
              <span class="h-1.5 w-1.5 rounded-full <%= status_label.downcase == 'posted' ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
              <%= status_label %>
            </span>
          </div>
        </div>
      </div>

      <%# Details Grid %>
      <div class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Transaction Date</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= transaction_date %></p>
          <p class="text-xs text-slate-500"><%= relative_time %> ago</p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Currency</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= currency %></p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Transaction Type</p>
          <p class="mt-1 text-sm font-semibold text-slate-900"><%= type_label %></p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Reference</p>
          <p class="mt-1 font-mono text-xs text-slate-600"><%= @transaction.id %>-<%= @transaction.created_at.to_i %></p>
        </div>
      </div>
    </div>

    <%# Linked Email Card %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-6 py-4">
        <h3 class="text-sm font-semibold text-slate-900">Linked Email</h3>
      </div>
      <div class="p-6">
        <% if email.present? %>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-medium text-slate-900"><%= email.subject.presence || "(no subject)" %></p>
              <p class="mt-1 text-sm text-slate-500">From email #<%= email.id %></p>
            </div>
            <%= link_to email_path(email),
                class: "inline-flex items-center gap-1.5 rounded-lg bg-emerald-50 px-3 py-1.5 text-sm font-medium text-emerald-700 hover:bg-emerald-100",
                data: { turbo_frame: "_top" } do %>
              View Email
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center gap-3 text-slate-500">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">No email linked to this transaction</span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Notes Card %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-6 py-4">
        <h3 class="text-sm font-semibold text-slate-900">Notes</h3>
        <p class="text-xs text-slate-500"><%= @transaction.notes.present? ? "Captured during review" : "No notes added" %></p>
      </div>
      <div class="p-6">
        <% if @transaction.notes.present? %>
          <div class="prose prose-sm prose-slate max-w-none">
            <%= simple_format(@transaction.notes) %>
          </div>
        <% else %>
          <p class="text-sm italic text-slate-400">No reviewer notes have been added for this transaction.</p>
        <% end %>
      </div>
    </div>

    <%# Metadata Card %>
    <div class="mt-6 rounded-xl border border-dashed border-slate-300 bg-slate-50 shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-200 px-6 py-4">
        <div>
          <h3 class="text-sm font-semibold text-slate-700">Raw Metadata</h3>
          <p class="text-xs text-slate-500">Useful for debugging import issues</p>
        </div>
        <span class="rounded-full bg-slate-200 px-2 py-0.5 text-xs font-medium text-slate-600">Internal</span>
      </div>
      <div class="p-6">
        <pre class="max-h-64 overflow-auto rounded-lg bg-white p-4 font-mono text-xs leading-relaxed text-slate-600"><%= @transaction.metadata.presence || "No metadata stored." %></pre>
      </div>
    </div>
  </div>
</div>
