<% transactions = @transactions.load %>
<% metrics = @metrics %>
<% total_transactions = metrics.total %>
<% expense_transactions = metrics.expense_total %>
<% dominant_currency = metrics.dominant_currency %>
<% total_amount_display = expense_transactions.positive? ? number_to_currency(metrics.total_amount_cents / 100.0, unit: dominant_currency, format: "%u %n") : "—" %>
<% average_amount_display = expense_transactions.positive? ? number_to_currency(metrics.average_amount_cents / 100.0, unit: dominant_currency, format: "%u %n") : "—" %>
<% expense_merchants = metrics.unique_merchants %>
<% linked_email_count = metrics.linked_email_count %>
<% linked_email_percentage = metrics.linked_email_percentage %>
<% status_counts = metrics.status_counts(5) %>
<% type_counts = metrics.type_counts %>

<div class="min-h-screen bg-slate-50">
  <%# Header %>
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-4">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-semibold text-slate-900">Transactions</h1>
          <p class="text-sm text-slate-500">Track and manage your financial activity</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
            <%= total_transactions %> records
          </span>
          <%= link_to emails_path,
              class: "inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-slate-800",
              data: { turbo_frame: "_top" } do %>
            View Inbox
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-6">
    <%# Stats Cards %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Total Volume</p>
        <p class="mt-2 text-2xl font-bold text-slate-900"><%= total_amount_display %></p>
        <p class="mt-1 text-xs text-slate-500"><%= expense_transactions %> expense transactions</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Average Amount</p>
        <p class="mt-2 text-2xl font-bold text-slate-900"><%= average_amount_display %></p>
        <p class="mt-1 text-xs text-slate-500"><%= expense_merchants %> merchants</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Linked Emails</p>
        <p class="mt-2 text-2xl font-bold text-slate-900"><%= linked_email_count %></p>
        <p class="mt-1 text-xs text-slate-500"><%= linked_email_percentage %>% connected</p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Total Records</p>
        <p class="mt-2 text-2xl font-bold text-slate-900"><%= total_transactions %></p>
        <p class="mt-1 text-xs text-slate-500">All transaction types</p>
      </div>
    </div>

    <%# Search and Filters %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
      <%= form_with url: transactions_path,
          method: :get,
          data: {
            turbo_frame: "transactions_list",
            controller: "search",
            action: "turbo:submit-end->search#clear turbo:load@document->search#focusInput",
            "search-delay-value": 300
          },
          class: "flex flex-col gap-4 md:flex-row md:items-center" do %>
        <div class="relative flex-1">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
            </svg>
          </span>
          <input
            type="search"
            name="q"
            value="<%= params[:q].to_s %>"
            placeholder="Search by merchant, notes, or category..."
            data-search-target="input"
            data-action="input->search#input"
            class="focus-ring w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-10 pr-4 text-sm placeholder-slate-400" />
        </div>
        <% if @selected_transaction_type.present? %>
          <%= hidden_field_tag :transaction_type, @selected_transaction_type %>
        <% end %>
        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800">
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
          </svg>
          Search
        </button>
      <% end %>

      <%# Type Filter Pills %>
      <% if type_counts.present? %>
        <% selected_type = @selected_transaction_type %>
        <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
          <% type_counts.each do |entry| %>
            <% label = entry[:label] %>
            <% count = entry[:count] %>
            <% key = entry[:key] %>
            <% active = key.present? && key == selected_type %>
            <% if key.present? %>
              <% link_params = request.query_parameters.deep_dup %>
              <% if active %>
                <% link_params.delete("transaction_type") %>
              <% else %>
                <% link_params["transaction_type"] = key %>
              <% end %>
              <%= link_to transactions_path(link_params),
                  class: "inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium transition #{active ? 'bg-slate-900 text-white' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'}",
                  data: { turbo_frame: "_top" } do %>
                <%= label %>
                <span class="<%= active ? 'bg-white/20' : 'bg-white' %> rounded-full px-1.5 py-0.5"><%= count %></span>
              <% end %>
            <% else %>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-50 px-3 py-1 text-xs font-medium text-slate-400">
                <%= label %>
                <span class="rounded-full bg-white px-1.5 py-0.5"><%= count %></span>
              </span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Transactions Table %>
    <turbo-frame id="transactions_list">
      <%= render "transactions/table", transactions: transactions %>
    </turbo-frame>
  </div>
</div>
