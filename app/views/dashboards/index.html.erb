<% summary = @summary %>
<% currency_unit = summary.dominant_currency %>
<% total_transactions = summary.total_transactions %>
<% lifetime_spend_display = currency_amount(summary.lifetime_spend_cents, unit: currency_unit) %>
<% current_month_spend_display = currency_amount(summary.current_month_spend_cents, unit: currency_unit) %>
<% average_transaction_display = total_transactions.positive? ? currency_amount(summary.average_transaction_cents, unit: currency_unit) : "—" %>
<% trend = summary.recent_trend %>
<% trend_delta = trend[:current] - trend[:previous] %>
<% trend_pct = trend[:previous].positive? ? ((trend_delta.to_f / trend[:previous]) * 100).round : nil %>
<% latest_sync_at = summary.latest_sync_at %>
<% type_breakdown = summary.transaction_type_breakdown %>

<div class="min-h-screen bg-slate-50">
  <%# Header %>
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-6 py-4">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-xl font-semibold text-slate-900">Dashboard</h1>
          <p class="text-sm text-slate-500">Overview of your financial activity</p>
        </div>
        <div class="flex items-center gap-3">
          <% if latest_sync_at.present? %>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1 text-xs font-medium text-emerald-700">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              Synced <%= time_ago_in_words(latest_sync_at) %> ago
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-7xl px-6 py-6">
    <%# Main Stats Grid %>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
      <%# Portfolio Value Card %>
      <div class="lg:col-span-2">
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-start justify-between">
            <div>
              <p class="text-sm font-medium text-slate-500">Total Lifetime Spend</p>
              <p class="mt-2 text-4xl font-bold tracking-tight text-slate-900"><%= lifetime_spend_display %></p>
              <div class="mt-2 flex items-center gap-2">
                <% if trend_pct.present? %>
                  <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium <%= trend_delta >= 0 ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700' %>">
                    <% if trend_delta >= 0 %>
                      <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 17a.75.75 0 01-.75-.75V5.612L5.29 9.77a.75.75 0 01-1.08-1.04l5.25-5.5a.75.75 0 011.08 0l5.25 5.5a.75.75 0 11-1.08 1.04l-3.96-4.158V16.25A.75.75 0 0110 17z" clip-rule="evenodd" /></svg>
                    <% else %>
                      <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z" clip-rule="evenodd" /></svg>
                    <% end %>
                    <%= trend_pct.abs %>% vs last week
                  </span>
                <% elsif trend[:current].positive? %>
                  <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">
                    New activity
                  </span>
                <% end %>
                <span class="text-sm text-slate-500"><%= number_with_delimiter(total_transactions) %> transactions</span>
              </div>
            </div>
            <div class="rounded-lg bg-slate-100 p-2">
              <svg class="h-6 w-6 text-slate-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" />
              </svg>
            </div>
          </div>

          <%# Transaction Type Pills %>
          <% if type_breakdown.present? %>
            <div class="mt-6 flex flex-wrap gap-2">
              <% type_breakdown.each do |entry| %>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-medium text-slate-700">
                  <%= entry[:label] %>
                  <span class="rounded-full bg-white px-1.5 py-0.5 text-slate-900"><%= entry[:count] %></span>
                </span>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Summary Panel %>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-900">Summary</h3>
        <div class="mt-4 space-y-4">
          <div class="flex items-center justify-between rounded-lg bg-emerald-50 p-3">
            <div class="flex items-center gap-2">
              <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100">
                <svg class="h-4 w-4 text-emerald-600" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
                </svg>
              </div>
              <span class="text-sm font-medium text-emerald-900">Tracking Active</span>
            </div>
            <span class="text-xs font-medium text-emerald-700">Good</span>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-600">This Month</span>
              <span class="text-sm font-semibold text-slate-900"><%= current_month_spend_display %></span>
            </div>
            <p class="mt-1 text-xs text-slate-500"><%= number_with_delimiter(summary.current_month_transactions) %> transactions in <%= summary.current_month_label %></p>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-600">7-Day Activity</span>
              <span class="text-sm font-semibold text-slate-900"><%= trend[:current] %> transactions</span>
            </div>
            <p class="mt-1 text-xs text-slate-500">vs <%= trend[:previous] %> previous week</p>
          </div>

          <div class="border-t border-slate-100 pt-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-slate-600">Avg Transaction</span>
              <span class="text-sm font-semibold text-slate-900"><%= average_transaction_display %></span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Categories and Merchants Grid %>
    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <%# Top Categories %>
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-4">
          <h3 class="text-sm font-semibold text-slate-900">Top Categories</h3>
          <p class="text-xs text-slate-500">Current month spending by category</p>
        </div>
        <div class="p-6">
          <% if summary.top_categories.present? %>
            <div class="space-y-3">
              <% summary.top_categories.each_with_index do |entry, index| %>
                <% colors = ['bg-emerald-500', 'bg-blue-500', 'bg-amber-500', 'bg-purple-500', 'bg-pink-500'] %>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="h-2 w-2 rounded-full <%= colors[index % colors.size] %>"></div>
                    <span class="text-sm font-medium text-slate-700"><%= entry[:label] %></span>
                  </div>
                  <span class="text-sm font-semibold text-slate-900"><%= currency_amount(entry[:amount_cents], unit: currency_unit) %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-slate-500">No categorized spend yet this month.</p>
          <% end %>
        </div>
      </div>

      <%# Top Merchants %>
      <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-4">
          <h3 class="text-sm font-semibold text-slate-900">Top Merchants</h3>
          <p class="text-xs text-slate-500">Last 30 days spending</p>
        </div>
        <div class="p-6">
          <% if summary.top_merchants.present? %>
            <div class="space-y-3">
              <% summary.top_merchants.each do |entry| %>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-slate-100 text-xs font-bold text-slate-600">
                      <%= entry[:label].first(2).upcase %>
                    </div>
                    <span class="text-sm font-medium text-slate-700"><%= entry[:label] %></span>
                  </div>
                  <span class="text-sm font-semibold text-slate-900"><%= currency_amount(entry[:amount_cents], unit: currency_unit) %></span>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-slate-500">We need more merchant data to populate this view.</p>
          <% end %>
        </div>
      </div>
    </div>

    <%# Inbox Status %>
    <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
      <%# Email Stats %>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-semibold text-slate-900">Total Emails</h3>
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600">
            <%= summary.connected_accounts_count %> accounts
          </span>
        </div>
        <p class="mt-3 text-3xl font-bold text-slate-900"><%= number_with_delimiter(summary.total_emails) %></p>
        <p class="mt-1 text-sm text-slate-500"><%= number_with_delimiter(summary.processed_emails) %> processed</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-900">Pending</h3>
        <p class="mt-3 text-3xl font-bold text-amber-600"><%= number_with_delimiter(summary.pending_emails) %></p>
        <p class="mt-1 text-sm text-slate-500"><%= number_with_delimiter(summary.emails_without_transactions) %> without transactions</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-900">Last Sync</h3>
        <% if latest_sync_at.present? %>
          <p class="mt-3 text-lg font-semibold text-emerald-600"><%= time_ago_in_words(latest_sync_at) %> ago</p>
          <p class="mt-1 text-sm text-slate-500"><%= l(latest_sync_at, format: :long) %></p>
        <% else %>
          <p class="mt-3 text-sm text-slate-500">No sync activity yet</p>
        <% end %>
      </div>
    </div>

    <%# Connected Accounts Table %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-6 py-4">
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Connected Accounts</h3>
          <p class="text-xs text-slate-500">Sync status for linked mailboxes</p>
        </div>
        <%= link_to emails_path,
            class: "inline-flex items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-medium text-white hover:bg-slate-800",
            data: { turbo_frame: "_top" } do %>
          View Inbox
          <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>

      <% if summary.connected_accounts_count.zero? %>
        <div class="p-6">
          <div class="rounded-lg border-2 border-dashed border-slate-200 p-6 text-center">
            <svg class="mx-auto h-10 w-10 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
            </svg>
            <p class="mt-3 text-sm font-medium text-slate-900">No accounts connected</p>
            <p class="mt-1 text-sm text-slate-500">Connect an email account to start ingesting transactions.</p>
          </div>
        </div>
      <% else %>
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50">
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Account</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Provider</th>
                <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wider text-slate-500">Status</th>
                <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wider text-slate-500">Last Sync</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% summary.latest_sync_by_account.each do |row| %>
                <% account = row[:account] %>
                <% last_synced_at = row[:last_synced_at] %>
                <tr class="table-row-hover">
                  <td class="whitespace-nowrap px-6 py-4">
                    <span class="text-sm font-medium text-slate-900"><%= account.email_address %></span>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <span class="text-sm capitalize text-slate-600"><%= account.provider %></span>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4">
                    <% status_label = account.status.to_s.presence || "Unknown" %>
                    <% status_active = status_label.downcase == "active" %>
                    <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs font-medium <%= status_active ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                      <span class="h-1.5 w-1.5 rounded-full <%= status_active ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
                      <%= status_label.titleize %>
                    </span>
                  </td>
                  <td class="whitespace-nowrap px-6 py-4 text-right">
                    <% if last_synced_at.present? %>
                      <span class="text-sm text-slate-900"><%= time_ago_in_words(last_synced_at) %> ago</span>
                    <% else %>
                      <span class="text-sm text-slate-500">Awaiting first sync</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </div>
</div>
