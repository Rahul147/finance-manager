<div class="sticky top-0 z-10 flex h-screen w-16 flex-shrink-0 flex-col border-r border-slate-200 bg-white" id="main-nav-content" data-turbo-permanent>
  <div class="flex h-full flex-col items-center justify-between py-6">
    <%# Logo %>
    <div class="mb-6">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-500 text-white">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </div>
    </div>

    <%# Navigation Links %>
    <div class="flex flex-col items-center space-y-2">
      <%= link_to dashboard_path,
        class: "nav-link group flex h-10 w-10 items-center justify-center rounded-xl #{current_page?(dashboard_path) ? 'nav-link--active' : 'text-slate-500 hover:text-slate-900'}",
        data: { turbo_frame: "_top", turbo_action: "advance", navbar_target: "link", nav_path: dashboard_path },
        aria: current_page?(dashboard_path) ? { current: "page" } : {},
        title: "Dashboard" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
        </svg>
      <% end %>

      <%= link_to transactions_path,
          class: "nav-link group flex h-10 w-10 items-center justify-center rounded-xl #{current_page?(transactions_path) ? 'nav-link--active' : 'text-slate-500 hover:text-slate-900'}",
          data: { turbo_frame: "_top", turbo_action: "advance", navbar_target: "link", nav_path: transactions_path },
          aria: current_page?(transactions_path) ? { current: "page" } : {},
          title: "Transactions" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25v10.5A2.25 2.25 0 0 0 4.5 19.5Z" />
        </svg>
      <% end %>

      <%= link_to emails_path,
          class: "nav-link group flex h-10 w-10 items-center justify-center rounded-xl #{current_page?(emails_path) ? 'nav-link--active' : 'text-slate-500 hover:text-slate-900'}",
          data: { turbo_frame: "_top", turbo_action: "advance", navbar_target: "link", nav_path: emails_path },
          aria: current_page?(emails_path) ? { current: "page" } : {},
          title: "Emails" do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
        </svg>
      <% end %>
    </div>

    <%# Spacer %>
    <div class="flex-1"></div>

    <%# Sign out %>
    <div>
      <%= button_to session_path,
          method: :delete,
          class: "nav-link group flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 hover:bg-red-50 hover:text-red-600",
          aria: { label: "Sign out" },
          title: "Sign out",
          form: { class: "contents", data: { turbo_frame: "_top", turbo_action: "advance" } } do %>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9" />
        </svg>
      <% end %>
    </div>
  </div>
</div>
