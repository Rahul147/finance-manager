<% subject = @email.subject.presence || "(no subject)" %>
<% transaction = @email.financial_transaction %>
<% sent_at_primary = @email.sent_at&.in_time_zone&.strftime("%b %d, %Y · %I:%M %p") %>
<% sent_relative = @email.sent_at.present? ? time_ago_in_words(@email.sent_at) : nil %>
<% status_label = @email.processed? ? "Processed" : "Pending" %>
<% sanitized_body = sanitized_email_html(@email) %>

<div class="min-h-screen bg-slate-50">
  <%# Header %>
  <div class="border-b border-slate-200 bg-white">
    <div class="mx-auto max-w-5xl px-6 py-4">
      <div class="flex items-center gap-4">
        <%= link_to emails_path,
            class: "inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-200",
            data: { turbo_frame: "_top" } do %>
          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M17 10a.75.75 0 01-.75.75H5.612l4.158 3.96a.75.75 0 11-1.04 1.08l-5.5-5.25a.75.75 0 010-1.08l5.5-5.25a.75.75 0 111.04 1.08L5.612 9.25H16.25A.75.75 0 0117 10z" clip-rule="evenodd" />
          </svg>
          Back
        <% end %>
        <span class="text-sm text-slate-500">Email #<%= @email.id %></span>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-5xl px-6 py-6">
    <%# Main Card %>
    <div class="rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 class="text-xl font-bold text-slate-900"><%= subject %></h1>
            <p class="mt-2 text-sm text-slate-500">
              From: <span class="font-medium text-slate-700"><%= @email.from_address.presence || "Unknown sender" %></span>
            </p>
          </div>
          <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium <%= @email.processed? ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
            <span class="h-1.5 w-1.5 rounded-full <%= @email.processed? ? 'bg-emerald-500' : 'bg-amber-500' %>"></span>
            <%= status_label %>
          </span>
        </div>
      </div>

      <%# Details Grid %>
      <div class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">From</p>
          <p class="mt-1 break-words text-sm font-medium text-slate-900"><%= @email.from_address.presence || "Unknown" %></p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">To</p>
          <p class="mt-1 break-words text-sm font-medium text-slate-900"><%= @email.to_address.presence || "Unknown" %></p>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Sent</p>
          <p class="mt-1 text-sm font-medium text-slate-900"><%= sent_at_primary || "Not available" %></p>
          <% if sent_relative.present? %>
            <p class="text-xs text-slate-500"><%= sent_relative %> ago</p>
          <% end %>
        </div>
        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-slate-500">Thread ID</p>
          <p class="mt-1 font-mono text-xs text-slate-600"><%= @email.thread_id.presence || "—" %></p>
        </div>
      </div>
    </div>

    <%# Snippet %>
    <% if @email.snippet.present? %>
      <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h3 class="text-sm font-semibold text-slate-900">Preview</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600"><%= @email.snippet %></p>
      </div>
    <% end %>

    <%# Linked Transaction %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-6 py-4">
        <h3 class="text-sm font-semibold text-slate-900">Linked Transaction</h3>
      </div>
      <div class="p-6">
        <% if transaction.present? %>
          <div class="flex items-start justify-between gap-4">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-lg bg-slate-100 text-sm font-bold text-slate-600">
                <%= transaction.merchant.presence&.first(2)&.upcase || "??" %>
              </div>
              <div>
                <p class="font-medium text-slate-900"><%= transaction.merchant.presence || "Unknown merchant" %></p>
                <p class="text-sm text-slate-500">
                  <% currency = transaction.currency.presence || "INR" %>
                  <% amount_display = transaction.amount_cents.present? ? number_to_currency(transaction.amount_cents / 100.0, unit: currency, format: "%u %n") : "—" %>
                  <%= amount_display %> &bull; <%= transaction.transaction_date || transaction.created_at.to_date %>
                </p>
              </div>
            </div>
            <%= link_to transaction_path(transaction),
                class: "inline-flex items-center gap-1.5 rounded-lg bg-emerald-50 px-3 py-1.5 text-sm font-medium text-emerald-700 hover:bg-emerald-100",
                data: { turbo_frame: "_top" } do %>
              View Transaction
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
              </svg>
            <% end %>
          </div>
        <% else %>
          <div class="flex items-center gap-3 text-slate-500">
            <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm">No transaction extracted from this email yet</span>
          </div>
        <% end %>
      </div>
    </div>

    <%# Message Body %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-6 py-4">
        <h3 class="text-sm font-semibold text-slate-900">Message Body</h3>
        <p class="text-xs text-slate-500">
          <%= sanitized_body.present? ? "HTML content" : (@email.body_text.present? ? "Plain text" : "No content available") %>
        </p>
      </div>
      <div class="p-6">
        <% if sanitized_body.present? %>
          <div class="prose prose-sm prose-slate max-w-none">
            <%= sanitized_body %>
          </div>
        <% elsif @email.body_text.present? %>
          <pre class="max-h-96 overflow-auto whitespace-pre-wrap rounded-lg bg-slate-50 p-4 font-mono text-xs leading-relaxed text-slate-700"><%= @email.body_text %></pre>
        <% else %>
          <p class="text-sm italic text-slate-400">The sender did not include any readable content.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
